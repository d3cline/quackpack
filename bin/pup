#!/usr/bin/env php
<?php
declare(strict_types=1);
if(PHP_VERSION_ID<80200){fwrite(STDERR,"Quackpack needs PHP 8.2+. Run php85 bin/quackpack or use its auto-selecting launcher.\n");exit(1);}
require dirname(__DIR__).'/app/bootstrap.php';

function options(array $args): array {
    $out=[];foreach($args as $arg){if(!str_starts_with($arg,'--'))throw new InvalidArgumentException('Use --option=value.');[$k,$v]=array_pad(explode('=',substr($arg,2),2),2,true);$out[$k]=$v;}return $out;
}
function atomicConfig(string $file,array $c): void {
    $tmp=$file.'.'.bin2hex(random_bytes(6));
    if(file_put_contents($tmp,"<?php\n// Private, generated by Quackpack. Keep outside the web root.\nreturn ".var_export($c,true).";\n",LOCK_EX)===false)throw new RuntimeException('Cannot write the configuration.');
    chmod($tmp,0600);if(!rename($tmp,$file))throw new RuntimeException('Cannot activate the configuration.');
}
function requirements(): void {
    if(PHP_VERSION_ID<80200)throw new RuntimeException('Quackpack needs PHP 8.2 or newer.');
    foreach(['pdo','curl','openssl','gd','mbstring','fileinfo'] as $ext)if(!extension_loaded($ext))throw new RuntimeException('Missing PHP extension: '.$ext);
}

try {
    $cmd=$argv[1]??'help';$o=options(array_slice($argv,2));
    $configFile=$cmd==='help'?'':pup_config_file($cmd==='install'&&isset($o['data-dir'])?(string)$o['data-dir']:null);
    if($cmd==='install'){
        requirements();
        if(is_file($configFile))throw new RuntimeException('Configuration already exists; identity and keys were left intact. To finish an interrupted deployment, run this CLI with repair.');
        $url=rtrim((string)($o['url']??''),'/');$parts=parse_url($url);
        $dev=isset($o['development']) && in_array($parts['host']??'', ['localhost','127.0.0.1'],true);
        if(!Pup\Http::validUrl($url) && !($dev&&($parts['scheme']??'')==='http'))throw new InvalidArgumentException('Use --url=https://your-domain.example (HTTPS is required).');
        if(!empty($parts['path'])||isset($parts['query'])||isset($parts['fragment']))throw new InvalidArgumentException('Install at the root of a domain or subdomain.');
        $user=(string)($o['username']??'');if(!preg_match('/^[a-z][a-z0-9_]{0,29}$/',$user))throw new InvalidArgumentException('Use --username=name (lowercase letters, numbers, underscores).');
        $password=getenv('PUP_PASSWORD');
        if($password===false||strlen($password)<14)throw new InvalidArgumentException('Supply a password of at least 14 characters through PUP_PASSWORD.');
        $source=realpath(dirname(__DIR__));
        $root=Pup\Installer::documentRoot($source,isset($o['docroot'])?(string)$o['docroot']:null);
        $data=(string)($o['data-dir']??pup_private_dir());
        if(!str_starts_with($data,'/'))throw new InvalidArgumentException('--data-dir must be an absolute path.');
        if(!is_dir($data)&&!mkdir($data,0700,true))throw new RuntimeException('Cannot create the data directory.');
        $data=realpath($data);
        if(pup_path_within($data,$root))throw new InvalidArgumentException('Keep private data outside the application document root, under your home directory.');
        if(pup_path_within($root,$data))throw new InvalidArgumentException('The private directory must not contain the document root.');
        if(!chmod($data,0700))throw new RuntimeException('Cannot restrict private directory permissions.');
        if(file_exists($data.'/runtime')||is_link($data.'/runtime'))throw new RuntimeException('The private runtime destination already exists. It was left intact.');
        foreach(['media','sessions'] as $dir)if(!is_dir($data.'/'.$dir))mkdir($data.'/'.$dir,0700);
        $configFile=getenv('PUP_CONFIG')?:$data.'/config.php';
        if(!str_starts_with($configFile,'/'))throw new InvalidArgumentException('PUP_CONFIG must be an absolute private file path.');
        if(!is_dir(dirname($configFile)))mkdir(dirname($configFile),0700,true);
        if(pup_path_within(realpath(dirname($configFile)),$root))throw new InvalidArgumentException('Keep the configuration outside the application document root.');
        if(is_file($configFile))throw new RuntimeException('A configuration already exists at the private destination. It was left intact.');
        $dsn=getenv('PUP_DSN')?:'sqlite:'.$data.'/pup.sqlite';
        if(!str_starts_with($dsn,'sqlite:')&&!str_starts_with($dsn,'mysql:'))throw new InvalidArgumentException('Use SQLite, MySQL, or MariaDB through PDO.');
        if(str_starts_with($dsn,'sqlite:')&&!str_starts_with(substr($dsn,7),'/'))throw new InvalidArgumentException('SQLite needs an absolute persistent database file path.');
        if(str_starts_with($dsn,'sqlite:')){
            $dbFile=substr($dsn,7);$parent=realpath(dirname($dbFile));
            if(!$parent||is_link($dbFile)||pup_path_within($parent,$root))throw new InvalidArgumentException('Keep the SQLite database outside the application document root, in an existing private directory, without a file symlink.');
        }
        $key=openssl_pkey_new(['private_key_bits'=>3072,'private_key_type'=>OPENSSL_KEYTYPE_RSA]);
        if(!$key||!openssl_pkey_export($key,$private))throw new RuntimeException('Cannot generate the federation identity.');
        $publicKey=openssl_pkey_get_details($key)['key'];
        $c=['base_url'=>$url,'username'=>$user,'display_name'=>mb_substr((string)($o['name']??ucfirst($user)),0,80),
            'password_hash'=>password_hash($password,PASSWORD_DEFAULT),'private_key'=>$private,'public_key'=>$publicKey,
            'data_dir'=>$data,'document_root'=>$root,'routing'=>'query','dsn'=>$dsn,'db_user'=>getenv('PUP_DB_USER')?:null,'db_password'=>getenv('PUP_DB_PASSWORD')?:null,'development'=>$dev];
        umask(0077);$app=pup($c);$app->store->migrate();atomicConfig($configFile,$c);
        $runtime=Pup\Installer::deploy($source,$root,$data,$configFile);
        echo Pup\App::json(['installed'=>true,'url'=>$url,'actor'=>$app->actorId(),'address'=>'@'.$user.'@'.$parts['host'],
            'document_root'=>$root,'private_directory'=>$data,'runtime'=>$runtime,'cli'=>$runtime.'/bin/quackpack','config'=>$configFile,'php'=>PHP_VERSION,'php_binary'=>PHP_BINARY,
            'cron'=>'* * * * * '.escapeshellarg(PHP_BINARY).' '.escapeshellarg($runtime.'/bin/quackpack').' work --seconds=45 --limit=50'])."\n";exit;
    }
    if($cmd==='help'){
        echo "Quackpack 0.5.1 — one person, one domain, a wider world.\n\n";
        echo "install --url=https://photos.example --username=name --name='Your Name' [--data-dir=/home/USER/quackpack] [--docroot=/absolute/app/path]\n";
        echo "  Private files default to \$HOME/quackpack. No rewrites or Nginx configuration required.\n";
        echo "  Required: PUP_PASSWORD (14+ characters). Optional: PUP_DSN, PUP_DB_USER, PUP_DB_PASSWORD.\n";
        echo "repair [--source=/absolute/release/path] Finish deployment using existing identity/data; no new keys or password.\n";
        echo "work [--limit=50] [--seconds=45]   Process federation deliveries (cron every minute).\n";
        echo "doctor [--federation]              Check runtime/worker; optionally probe public federation URLs.\n";
        echo "password                          Set owner password from PUP_PASSWORD.\n";
        echo "migrate                           Apply the idempotent schema.\n";
        echo "export                            Write JSON to stdout (posts, saved, relationships, profile).\n";
        echo "retry                             Requeue failed deliveries.\n";
        echo "discover --action=start|pause|status|seed|watch|recheck [--value=domain-or-profile-url]\n";
        exit;
    }
    $app=pup();
    if($cmd==='repair'){
        requirements();$c=$app->config;
        if(($c['routing']??'')!=='query')throw new RuntimeException('Repair supports the HOME layout only; it does not migrate pretty-URL identities.');
        $source=realpath((string)($o['source']??dirname(__DIR__)));
        $root=realpath((string)($c['document_root']??''));
        $data=realpath((string)$c['data_dir']);
        if(!$source||!is_file($source.'/app/Installer.php')||!is_file($source.'/bin/pup')||!is_dir($source.'/assets'))throw new RuntimeException('Use --source=/absolute/path/to/the/extracted/release.');
        if(!$root||!is_writable($root)||!$data||pup_path_within($data,$root)||pup_path_within($root,$data))throw new RuntimeException('Existing private storage and document root must be separate writable directories.');
        if(is_dir($root.'/.git'))throw new RuntimeException('The document root must not contain a Git checkout.');
        umask(0077);$app->store->migrate();$runtime=Pup\Installer::deploy($source,$root,$data,$configFile,true);
        echo Pup\App::json(['repaired'=>true,'url'=>$c['base_url'],'actor'=>$app->actorId(),'document_root'=>$root,'private_directory'=>$data,
            'runtime'=>$runtime,'cli'=>$runtime.'/bin/quackpack','config'=>$configFile,'php'=>PHP_VERSION,'php_binary'=>PHP_BINARY,
            'cron'=>'* * * * * '.escapeshellarg(PHP_BINARY).' '.escapeshellarg($runtime.'/bin/quackpack').' work --seconds=45 --limit=50'])."\n";
    }
    elseif($cmd==='work'){
        $seconds=max(1,min(55,(int)($o['seconds']??45)));$limit=max(1,min(1000,(int)($o['limit']??50)));$start=microtime(true);
        $delivery=$app->fed->work($limit,min(15,$seconds));
        $roaming=$app->discovery->work(max(0,(int)floor($seconds-(microtime(true)-$start))),min(30,$limit));
        echo Pup\App::json($delivery+['discovery'=>$roaming])."\n";
    }
    elseif($cmd==='discover'){
        $action=(string)($o['action']??'status');
        echo Pup\App::json($action==='status'?$app->discovery->status():$app->discovery->control($action,(string)($o['value']??'')))."\n";
    }
    elseif($cmd==='migrate'){$app->store->migrate();echo "Schema is current.\n";}
    elseif($cmd==='password'){
        $pw=getenv('PUP_PASSWORD');if($pw===false||strlen($pw)<14)throw new InvalidArgumentException('Supply PUP_PASSWORD with at least 14 characters.');
        $c=$app->config;$c['password_hash']=password_hash($pw,PASSWORD_DEFAULT);atomicConfig($configFile,$c);echo "Owner password updated; old sessions are invalidated.\n";
    } elseif($cmd==='doctor'){
        requirements();$app->store->query('SELECT 1');$c=$app->config;
        $issues=[];foreach(['','/media','/sessions'] as $dir)if(!is_writable($c['data_dir'].$dir))$issues[]='Not writable: '.$c['data_dir'].$dir;
        $worker=$app->store->get('meta','worker');if(($worker['last_run']??0)<time()-180)$issues[]='Worker has not checked in within three minutes. Configure cron.';
        if($c['development'])$issues[]='Development HTTP mode is enabled; federation needs a public HTTPS domain.';
        $federation=isset($o['federation'])?$app->fed->checkPublic():null;
        if($federation&&!$federation['ok'])$issues[]='A public federation endpoint failed its check.';
        $jobs=$app->store->query('SELECT state,COUNT(*) AS count FROM jobs GROUP BY state')->fetchAll();
        echo Pup\App::json(['ok'=>!$issues,'php'=>PHP_VERSION,'php_binary'=>PHP_BINARY,'database'=>$app->store->driver,'issues'=>$issues,'jobs'=>$jobs,'actor'=>$app->actorId(),'federation'=>$federation])."\n";exit($issues?1:0);
    } elseif($cmd==='export'){
        $out=['format'=>'pup-export-1','exported_at'=>gmdate('c'),'profile'=>$app->profile(),'links'=>$app->links()];
        foreach(['posts','saved','follows','followers','blocks'] as $bucket){$out[$bucket]=iterator_to_array($app->store->each($bucket),false);}
        echo Pup\App::json($out)."\n";
    } elseif($cmd==='retry'){$app->store->query("UPDATE jobs SET state='pending',attempts=0,due=?,updated=? WHERE state='failed'",[time(),time()]);echo "Failed deliveries requeued.\n";}
    else throw new InvalidArgumentException('Unknown command. Run php bin/quackpack help.');
} catch(Throwable $e){fwrite(STDERR,'Quackpack: '.$e->getMessage()."\n");exit(1);}
